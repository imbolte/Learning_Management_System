<!DOCTYPE html>
<html>
<head>
    <title>Order Confirmation</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { width: 80%; margin: 20px auto; padding: 20px; border: 1px solid #ddd; border-radius: 8px; }
        .header { text-align: center; border-bottom: 1px solid #ddd; padding-bottom: 10px; }
        .content { margin-top: 20px; }
        .course-info { background-color: #f9f9f9; padding: 15px; border-radius: 5px; }
        .footer { margin-top: 30px; text-align: center; color: #777; font-size: 0.9em; }
    </style>
</head>
<body>
    <div className="container">
        <div className="header">
            <h1>Order Confirmation</h1>
        </div>
        <div className="content">
            <p>Hello,</p>
            <p>Thank you for your purchase! Your order for the following course has been confirmed:</p>
            <div className="course-info">
                <p><strong>Course Name:</strong> <%= order.order.name %></p>
                <p><strong>Order ID:</strong> <%= order.order._id %></p>
                <p><strong>Price:</strong> $<%= order.order.price %></p>
                <p><strong>Date:</strong> <%= order.order.date %></p>
            </div>
            <p>You can now access your course from your dashboard.</p>
            <p>Happy learning!</p>
        </div>
        <div className="footer">
            <p>&copy; 2025 ELearning Platform. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
